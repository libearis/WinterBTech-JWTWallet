# =====================================================
# Backend (Go + Gin)
# =====================================================
APP_ENV=development
APP_PORT=8080

# Database
# Option B (local dev): DB_HOST=localhost
# Option A (docker compose): overridden to "db" automatically
DB_HOST=localhost
DB_PORT=5432
DB_USER=wallet_user
DB_PASSWORD=change-me
DB_NAME=wallet_db
DB_SSLMODE=disable

# JWT
# Must be at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=jwt-auth-wallet
JWT_TTL=15m

# Security
BCRYPT_COST=12
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Wallet (amounts in minor units: 100000 = 1,000.00)
INITIAL_BALANCE=100000
IDEMPOTENCY_KEY_TTL=24h

# =====================================================
# Frontend (Vue + Vite) — read at BUILD time
# =====================================================
VITE_API_BASE_URL=/api
VITE_IDLE_TIMEOUT_MS=900000
VITE_REQUEST_TIMEOUT_MS=20000
VITE_MAX_RETRIES=4
